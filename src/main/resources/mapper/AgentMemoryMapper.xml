<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minicodex.infrastructure.memory.AgentMemoryMapper">

    <resultMap id="MemoryRecordResultMap" type="com.minicodex.infrastructure.memory.MemoryRecord">
        <result property="key" column="memory_key"/>
        <result property="content" column="content"/>
        <result property="type" column="memory_type"/>
        <result property="createTime" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.minicodex.infrastructure.memory.MemoryRecord">
        INSERT INTO agent_memory (memory_key, content, memory_type, created_at)
        VALUES (#{key}, #{content}, #{type}, #{createTime})
    </insert>

    <select id="selectByKeyword" resultMap="MemoryRecordResultMap">
        SELECT memory_key, content, memory_type, created_at
        FROM agent_memory
        WHERE content LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteAll">
        DELETE FROM agent_memory
    </delete>
</mapper>
